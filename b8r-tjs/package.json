{
  "name": "b8r-tjs",
  "version": "0.0.1",
  "description": "A literate, runtime-type-safe UI framework: b8r's light-DOM model and tosijs's primitives ported into the tjs language. Stable by default, no service-worker vfs.",
  "type": "module",
  "scripts": {
    "build": "bun ./build.mjs",
    "test": "bun ./build.mjs && bun test",
    "demos": "bun ./build.mjs && bun ./demo/vendor.mjs",
    "start": "bun run demos && bun ./demo/serve.mjs",
    "serve": "bun ./demo/serve.mjs"
  },
  "keywords": [
    "tjs",
    "tosijs",
    "bindinator",
    "bun",
    "web-components",
    "literate",
    "runtime-types"
  ],
  "license": "MIT",
  "dependencies": {
    "tjs-lang": "^0.8.1",
    "tosijs": "^1.6.1"
  },
  "devDependencies": {
    "linkedom": "^0.18.12",
    "sucrase": "^3.35.1",
    "tosijs-ui": "^1.5.23"
  }
}
