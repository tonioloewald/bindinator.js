/*#
## b8r-tjs · components — a redefinable definition registry

Components are *definitions* held in a registry, not custom elements. Each
instance renders from whatever definition currently sits under its name, so
calling `defineComponent` again with the same name re-renders every live
instance from the new definition **with its state preserved** — hot reload, with
no `customElements` lock and no page reload.

Wiring is declarative and serializable. The element creator records bindings and
events as `data-bind` / `data-event` attributes; the component layer connects
them to instance state through `observe` and to the definition's `methods`. Two
consequences fall out for free: a definition can be rendered to a **static HTML
string** (`renderToString`, for SEO + TTFI), and that server markup can be
**hydrated in place** (`hydrate`) — adopted node-for-node, never rebuilt.

A definition is `{ name, state, methods, style, view }`:
- `state` — per-instance initial data (cloned per instance);
- `methods` — named event handlers `{ name(ctx, event) }`, referenced from the
  view as `onClick: 'name'` and dispatched from `data-event`;
- `style` — a CSS string (from `css(...)`), injected once per definition;
- `view(ctx)` — builds the DOM once; bindings/events are declared as attributes.
*/

import { get, set, observe, register } from './observe.tjs'

const definitions = {}     // name -> spec
const instances = {}       // instanceId -> { name, target, unobservers }
let nextId = 0

register('_c', {})         // root holding every instance's private state

function makeCtx (scope) {
  return {
    get (rel) { return get(scope + '.' + rel) },
    set (rel, value) { return set(scope + '.' + rel, value) },
    snapshot () { return get(scope) } // the whole instance state object
  }
}

function injectStyle (name, styleText) {
  if (styleText === undefined || styleText === null) return
  let styleEl = document.head.querySelector('style[data-component="' + name + '"]')
  if (styleEl === null) {
    styleEl = document.createElement('style')
    styleEl.setAttribute('data-component', name)
    document.head.append(styleEl)
  }
  styleEl.textContent = styleText
}

function walk (node, visit) {
  visit(node)
  const kids = node.childNodes
  if (kids !== undefined && kids !== null) {
    for (const kid of kids) {
      if (kid.nodeType === 1) walk(kid, visit)
    }
  }
}

// connect `data-bind="type:path"` markers to instance state, returning observers
function wireBindings (root, scope, unobservers) {
  walk(root, function (el) {
    const spec = el.getAttribute('data-bind')
    if (spec === null) return
    for (const token of spec.split(';')) {
      const pair = token.split(':')
      const target = pair[0] === 'text' ? 'textContent' : pair[0]
      const path = scope + '.' + pair[1]
      const update = function () { el[target] = get(path) }
      update()
      unobservers.push(observe(path, update))
    }
  })
}

// connect `data-event="event:method"` markers to the definition's methods
function wireEvents (root, ctx, methods) {
  walk(root, function (el) {
    const spec = el.getAttribute('data-event')
    if (spec === null) return
    for (const token of spec.split(';')) {
      const pair = token.split(':')
      const methodName = pair[1]
      el.addEventListener(pair[0], function (event) {
        const handler = methods[methodName]
        if (handler !== undefined) handler(ctx, event)
      })
    }
  })
}

function methodsOf (spec) {
  return spec.methods === undefined ? {} : spec.methods
}

function clearInstance (inst) {
  for (const unobserve of inst.unobservers) unobserve()
  inst.unobservers = []
  inst.target.textContent = ''
}

function renderInstance (instanceId) {
  const inst = instances[instanceId]
  const spec = definitions[inst.name]
  clearInstance(inst)
  const scope = '_c.' + instanceId
  const ctx = makeCtx(scope)
  const node = spec.view(ctx)
  inst.target.append(node)
  wireBindings(node, scope, inst.unobservers)
  wireEvents(node, ctx, methodsOf(spec))
}

// Define — or redefine — a component. If instances of this name are mounted,
// each is re-rendered from the new definition with its state preserved.
export function defineComponent (spec) {
  definitions[spec.name] = spec
  injectStyle(spec.name, spec.style)
  for (const instanceId of Object.keys(instances)) {
    if (instances[instanceId].name === spec.name) renderInstance(instanceId)
  }
  return spec
}

function initState (instanceId, state) {
  set('_c.' + instanceId, structuredClone(state === undefined ? {} : state))
}

// Mount an instance of a named component into a target element (builds the DOM).
export function mount (name: 'counter', target) {
  const instanceId = 'i' + nextId
  nextId = nextId + 1
  initState(instanceId, definitions[name].state)
  instances[instanceId] = { name, target, unobservers: [] }
  renderInstance(instanceId)
  return instanceId
}

// Render a definition to a static HTML string (for static generation / SSR).
// Bound values are baked in so the markup shows content; `data-bind`/`data-event`
// attributes travel with it so the client can hydrate.
export function renderToString (name: 'counter', state) {
  const spec = definitions[name]
  const scopeId = 'ssr' + nextId
  nextId = nextId + 1
  const initial = state === undefined ? spec.state : state
  initState(scopeId, initial)
  const scope = '_c.' + scopeId
  const node = spec.view(makeCtx(scope))
  walk(node, function (el) {
    const bindSpec = el.getAttribute('data-bind')
    if (bindSpec === null) return
    for (const token of bindSpec.split(';')) {
      const pair = token.split(':')
      const target = pair[0] === 'text' ? 'textContent' : pair[0]
      el[target] = get(scope + '.' + pair[1])
    }
  })
  const html = node.outerHTML
  set('_c.' + scopeId, undefined) // drop the throwaway scope
  return html
}

// Hydrate server-rendered markup already present in `target`: adopt the existing
// nodes (do NOT rebuild) and wire their `data-bind`/`data-event` attributes to a
// fresh instance. `state` should be the state the server rendered with.
export function hydrate (name: 'counter', target, state) {
  const instanceId = 'i' + nextId
  nextId = nextId + 1
  initState(instanceId, state === undefined ? definitions[name].state : state)
  instances[instanceId] = { name, target, unobservers: [] }
  const scope = '_c.' + instanceId
  const ctx = makeCtx(scope)
  const spec = definitions[name]
  for (const child of target.childNodes) {
    if (child.nodeType === 1) {
      wireBindings(child, scope, instances[instanceId].unobservers)
      wireEvents(child, ctx, methodsOf(spec))
    }
  }
  return instanceId
}

export function instancesOf (name: 'counter') {
  return Object.keys(instances).filter(function (id) {
    return instances[id].name === name
  })
}
