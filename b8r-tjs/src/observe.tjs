/*#
## b8r-tjs · observed state

Path-observed application state — the b8r/xin registry idea, ported into tjs.

This is **not** "reactive". The view is never a function of this state and
nothing re-renders wholesale. State is **stable by default**: `set`ting a path to
the value it already holds notifies no one. Bindings are *wiring* — an observer
watches a path and, when (and only when) that path actually changes, runs the one
small update it was wired to do. Mutating an object in place notifies no one
until you `touch` its path, on purpose.
*/

const registry = {}
const observers = []

// walk the registry along a pre-split path, stopping safely at any gap
function valueAtParts (parts: ['app', 'foo']) {
  let node = registry
  for (const part of parts) {
    if (node === null || node === undefined) return undefined
    node = node[part]
  }
  return node
}

// register a named root of state. This is the initial wiring-up; it does not
// notify observers (there is nothing yet wired to it).
export function register (name: 'app', value) {
  registry[name] = value
  return registry[name]
}

// read the value at a dotted path (undefined for any missing segment)
export function get (path: 'app.foo') {
  return valueAtParts(path.split('.'))
}

// an observer of `observed` should fire for a change at `changed` when either
// path contains the other: a change to app.foo.bar concerns observers of
// app.foo and of app.foo.bar.baz alike. The `: true` return example is a
// signature test — tjs runs the param examples through this at build time and
// fails the build if the result isn't `true`.
function pathsOverlap (observed: 'app.foo', changed: 'app.foo'): true {
  return (
    observed === changed ||
    observed.startsWith(changed + '.') ||
    changed.startsWith(observed + '.')
  )
}

function notify (changed: 'app.foo') {
  // copy first: a callback may add or remove observers while we iterate
  for (const observer of [...observers]) {
    if (pathsOverlap(observer.path, changed)) observer.callback(changed)
  }
}

// force-notify observers of a path — use after mutating an object in place
export function touch (path: 'app.foo') {
  notify(path)
}

// set the value at a dotted path. Stable by default: no notification unless the
// value actually changes (identity for objects — replace, or mutate + touch).
export function set (path: 'app.foo', value) {
  const parts = path.split('.')
  const last = parts.pop()
  const parent = valueAtParts(parts)
  if (parent === null || parent === undefined) return undefined
  if (parent[last] === value) return value
  parent[last] = value
  notify(path)
  return value
}

// wire a callback to a path. Returns an unobserve function.
export function observe (path: 'app.foo', callback) {
  const observer = { path, callback }
  observers.push(observer)
  return function unobserve () {
    const index = observers.indexOf(observer)
    if (index !== -1) observers.splice(index, 1)
  }
}

// Inline tests — literate, and run by the compiler at build time (build.mjs
// fails the build if any fail). They live next to the code they describe.

test 'get reads nested paths; gaps are undefined' {
  register('t1', { a: { b: 2 } })
  expect(get('t1.a.b')).toBe(2)
  expect(get('t1.a.nope')).toBe(undefined)
  expect(get('t1.nope.deep')).toBe(undefined)
}

test 'set is stable by default and notifies only on real change' {
  register('t2', { n: 1 })
  let fired = 0
  const off = observe('t2.n', () => { fired = fired + 1 })
  set('t2.n', 1)        // unchanged -> no notification
  expect(fired).toBe(0)
  set('t2.n', 2)        // changed -> one notification
  expect(fired).toBe(1)
  off()
  set('t2.n', 3)        // unobserved -> none
  expect(fired).toBe(1)
}

test 'touch fires the wire after a mutate-in-place' {
  register('t3', { obj: { x: 1 } })
  let fired = 0
  observe('t3.obj', () => { fired = fired + 1 })
  get('t3.obj').x = 99  // mutated in place -> silent
  expect(fired).toBe(0)
  touch('t3.obj')       // wiring fires on demand
  expect(fired).toBe(1)
}

test 'observers fire for overlapping ancestor/descendant paths' {
  register('t4', { a: { b: 1 } })
  let parent = 0
  let child = 0
  observe('t4.a', () => { parent = parent + 1 })
  observe('t4.a.b', () => { child = child + 1 })
  set('t4.a.b', 2)
  expect(parent).toBe(1)
  expect(child).toBe(1)
}
