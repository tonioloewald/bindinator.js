/*#
## b8r-tjs

The authoring surface: observed state, the element creator, css + variables, and
the redefinable component registry. (The literate compiler lives in
`./compile.tjs` and is imported directly by tooling/editors that need it — it
pulls in `tjs-lang`, so it is intentionally not part of this barrel.)
*/

export { register, get, set, observe, touch } from './observe.tjs'
export { elements } from './elements.tjs'
export { css, vars } from './css.tjs'
export { defineComponent, mount, hydrate, renderToString, instancesOf } from './component.tjs'
