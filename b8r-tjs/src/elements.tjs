/*#
## b8r-tjs · element creator

Build real DOM nodes from plain JavaScript — no HTML slabs. `elements.div(...)`
creates a `<div>`; `elements.myThing(...)` creates `<my-thing>`. Each creator
takes children (strings/numbers → text nodes, nodes → appended, arrays →
flattened, `null`/`false` → skipped) and plain-object props:

- `style` (object) → inline styles (camelCase keys);
- `onEvent` → a handler: a **string** names a method on the component definition
  and is recorded as a serializable `data-event="event:method"` attribute (this
  is what makes the DOM hydratable); a **function** is attached directly with
  `addEventListener` (client-only, not serializable);
- `bind*` (string) → a serializable `data-bind="type:path"` wiring marker
  (`bindText` → `text:path`, `bindValue` → `value:path`); the component layer
  resolves these against instance state — nothing here touches state;
- anything else → an attribute.

Because wiring lives in attributes (not closures), the same markup serializes for
static generation and is adopted as-is on hydration.
*/

function isNode (x) {
  return x !== null && typeof x === 'object' && typeof x.nodeType === 'number'
}

// 'onClick' -> 'click' (a return-example signature test, run at build time)
function eventName (key: 'onClick'): 'click' {
  return key.slice(2).toLowerCase()
}

// accumulate a `;`-separated token into an attribute (data-bind / data-event)
function addToken (el, attr, token) {
  const existing = el.getAttribute(attr)
  el.setAttribute(attr, existing === null ? token : existing + ';' + token)
}

function applyProps (el, props) {
  for (const key of Object.keys(props)) {
    const value = props[key]
    if (key === 'style' && value !== null && typeof value === 'object') {
      for (const styleKey of Object.keys(value)) {
        el.style[styleKey] = value[styleKey]
      }
    } else if (key.startsWith('on')) {
      if (typeof value === 'function') {
        el.addEventListener(eventName(key), value)
      } else {
        addToken(el, 'data-event', eventName(key) + ':' + value)
      }
    } else if (key.startsWith('bind')) {
      const type = key === 'bindText' ? 'text' : key.slice(4).toLowerCase()
      addToken(el, 'data-bind', type + ':' + value)
    } else {
      el.setAttribute(key, value)
    }
  }
}

function appendChild (el, child) {
  if (child === null || child === undefined || child === false) return
  if (Array.isArray(child)) {
    for (const each of child) appendChild(el, each)
  } else if (isNode(child)) {
    el.append(child)
  } else if (typeof child === 'object') {
    applyProps(el, child)
  } else {
    el.append(document.createTextNode(String(child)))
  }
}

export const elements = new Proxy({}, {
  get (_target, tag) {
    return function (...args) {
      const el = document.createElement(tag)
      for (const arg of args) appendChild(el, arg)
      return el
    }
  }
})
