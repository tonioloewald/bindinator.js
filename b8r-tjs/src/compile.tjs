/*#
## b8r-tjs · the component compiler

The literate heart of b8r-tjs — and the reason it has no `vfs`.

Classic b8r reconstructed an edited component, wrote it to a service-worker
"virtual file system", and re-`import()`ed it just so the browser's module
loader would accept the string. tjs removes the need entirely: a component's
source *is* tjs, tjs transpiles it to runnable JavaScript in-process (injecting
runtime type-validation and running any inline `test` blocks), and a `data:`
URL turns that string into a live ES module — no file, no service worker.
*/

import { tjs } from 'tjs-lang/lang'

/*
Transpile component source. Returns the emitted JavaScript plus whatever the
inline `test` blocks reported, so an editor can surface failures inline.
*/
export function compile (source: '') {
  const result = tjs(source)
  return {
    code: result.code,
    tests: result.testResults === undefined ? [] : result.testResults,
    warnings: result.warnings === undefined ? [] : result.warnings
  }
}

/*
Turn emitted JavaScript into a `data:` URL that `import()` accepts. This is the
single step that replaces b8r's whole `vfs` round-trip. We base64-encode (rather
than percent-encode) because it is UTF-8 safe and, unlike percent-encoding, bun's
data: loader classifies it as ES module correctly even when the code assigns
metadata to an exported binding (tjs emits `fn.__tjs = { ... }`).
*/
export function toModuleUrl (code: '') {
  const bytes = new TextEncoder().encode(code)
  let binary = ''
  for (const byte of bytes) {
    binary = binary + String.fromCharCode(byte)
  }
  return 'data:text/javascript;base64,' + btoa(binary)
}

/*
Turn emitted JavaScript into a `blob:` URL — the preferred form, because the
code travels in the object store instead of in the URL itself, so the URL is a
constant ~41 characters no matter how large the module is.

That matters: a `data:` URL carries the whole base64 payload inline, and bun
routes long ones through *package* resolution and throws `NameTooLong` once the
module exceeds a few kB (which every tjs module does, since tjs prepends its
runtime preamble). Browsers also cap `data:` URL length. Returns `null` where
`Blob`/`createObjectURL` don't exist.
*/
export function toModuleBlobUrl (code: '') {
  if (globalThis.URL === undefined) return null
  if (globalThis.URL.createObjectURL === undefined) return null
  if (globalThis.Blob === undefined) return null
  return globalThis.URL.createObjectURL(
    new globalThis.Blob([code], { type: 'text/javascript' })
  )
}

/*
Whether this runtime's `import()` accepts a `blob:` URL. Probed once with a
tiny throwaway module and cached, rather than try/catch around the real import
— that way a genuine error *inside* a compiled component is never mistaken for
"blob URLs are unsupported" and silently retried.

Browsers and bun: yes. Node: no — its ESM loader accepts only file/data/node
schemes, so it falls back to `data:` (which node handles at any size).
*/
let blobImportSupported = null

async function canImportBlobUrl () {
  if (blobImportSupported !== null) return blobImportSupported
  const url = toModuleBlobUrl('export default 1')
  if (url === null) {
    blobImportSupported = false
    return false
  }
  try {
    await import(url)
    blobImportSupported = true
  } catch (_e) {
    blobImportSupported = false
  }
  globalThis.URL.revokeObjectURL(url)
  return blobImportSupported
}

/*
Compile component source and import it as a live ES module. Self-contained
components (the common case for a live editor) need nothing else; components
with bare imports resolve those through the page's import map / CDN, exactly as
any other module would.

Relative imports inside a compiled component resolve against an opaque origin
and won't work — true of both URL forms, which is why `live.tjs` injects the
primitives it needs as `lib` rather than importing them.
*/
export async function load (source: '') {
  const compiled = compile(source)
  const useBlob = await canImportBlobUrl()
  const url = useBlob ? toModuleBlobUrl(compiled.code) : toModuleUrl(compiled.code)
  const module = await import(url)
  // Safe to revoke once import() has resolved: the module is already fetched
  // and instantiated, and these modules have no relative sub-imports to hang
  // off the base URL.
  if (useBlob) globalThis.URL.revokeObjectURL(url)
  return {
    module,
    tests: compiled.tests,
    warnings: compiled.warnings
  }
}
