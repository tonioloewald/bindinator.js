/*#
## b8r-tjs · legacy b8r-component loader

Runs a legacy b8r `.component.html` (optional `<!-- docs -->` + `<style>` +
markup + `<script>`) on the **tosijs** engine, so existing components work
unchanged. The markup's `data-bind` / `data-event` are hydrated through the
b8r→tosijs adapter with `_component_.x` rewritten to a per-instance scope, and
the `<script>` runs with a b8r-style instance context (`get`/`set`/`findOne`/
`find`/`on`/`touch`/`register`/`component`/`data`).

This is **trusted** compatibility code: the legacy script is executed with an
`AsyncFunction`, exactly as b8r always did. Untrusted components use the AJS
sandbox instead (see `untrusted.tjs`).
*/

import { tosi, xin, tosiValue } from 'tosijs'
import { hydrateB8r, getListInstance } from './b8r-compat.js'
import { defineExternalComponent, hydrateB8rComponents, setLegacyComponentLoader } from './b8r-blueprint.js'

const AsyncFunction = (async () => {}).constructor
let nextId = 0
let rootReady = false

function ensureRoot () {
  if (rootReady) return
  tosi({ _b8r: {} })
  rootReady = true
}

// rewrite b8r scope prefixes: `_component_.x` → this instance's private scope;
// `_data_.x` → the inherited data path (the target's `data-path` attribute),
// falling back to the private scope — b8r's rule.
function scoped (scope, dataPath, path) {
  if (path.startsWith('_component_')) return scope + path.slice('_component_'.length)
  if (path.startsWith('_data_')) return (dataPath || scope) + path.slice('_data_'.length)
  return path
}

function valueAtPath (path) {
  let node = xin
  for (const part of path.split('.')) {
    if (node === null || node === undefined) return undefined
    node = node[part]
  }
  return tosiValue(node)
}

// split a legacy component into { css, html, script }
function parseComponent (source) {
  let remains = source
  const docMatch = source.match(/^\s*<!--[\s\S]*?-->/)
  if (docMatch !== null) remains = source.slice(docMatch[0].length)
  let css = ''
  const styleParts = remains.split(/<style>|<\/style>/)
  if (styleParts.length === 3) {
    css = styleParts[1]
    remains = styleParts[2]
  }
  let html = remains
  let script = ''
  const scriptParts = remains.split(/<script[^>\n]*>|<\/script>/)
  if (scriptParts.length >= 3) {
    html = scriptParts[0]
    script = scriptParts[1]
  }
  return { css: css.trim(), html: html.trim(), script: script.trim() }
}

// Load a legacy b8r component source. Returns `mount(target, initialData)`.
// `options.base` (a URL string) gives the component's original location, so
// RELATIVE dynamic imports in its `<script>` resolve like they did in b8r
// (relative to the component). Without it, relative specifiers can't resolve —
// the script's `import(…)` calls are rewritten to a resolving helper.
export function loadB8rComponent (source, options = {}) {
  ensureRoot()
  const parts = parseComponent(source)
  if (parts.css !== '') {
    const style = document.createElement('style')
    style.textContent = parts.css
    document.head.append(style)
  }
  // `AsyncFunction` bodies have no module base URL, so a bare `import('../x')`
  // inside them cannot resolve. Route dynamic imports through `_import`, which
  // resolves relative specifiers against options.base when provided.
  const script = parts.script.replace(/\bimport\s*\(/g, '_import(')
  const _import = function (specifier) {
    if (options.base !== undefined && (specifier.startsWith('./') || specifier.startsWith('../'))) {
      return import(new URL(specifier, options.base).href)
    }
    return import(specifier)
  }

  return async function mount (target, initialData) {
    const id = 'i' + nextId
    nextId = nextId + 1
    const scope = '_b8r.' + id
    const dataPath = target.getAttribute === undefined ? null : target.getAttribute('data-path')
    xin._b8r[id] = initialData === undefined ? {} : initialData
    // b8r composition: the target's pre-existing markup children transclude into
    // the component's `[data-children]` (warned + dropped if the view has none)
    const markupChildren = [...target.childNodes]
    target.innerHTML = parts.html
    if (markupChildren.some(function (n) { return n.nodeType === 1 || (n.textContent || '').trim() !== '' })) {
      const childrenDest = target.querySelector('[data-children]')
      if (childrenDest === null) {
        console.warn('b8r-tjs: component children were provided but its view has no `[data-children]` element — dropped')
      } else {
        childrenDest.textContent = ''
        for (const child of markupChildren) childrenDest.append(child)
      }
    }

    const get = function (key) {
      const base = tosiValue(xin._b8r[id])
      return key === undefined ? base : base[key]
    }
    const set = function (keyOrObject, value) {
      if (keyOrObject !== null && typeof keyOrObject === 'object') {
        for (const key of Object.keys(keyOrObject)) xin._b8r[id][key] = keyOrObject[key]
      } else {
        xin._b8r[id][keyOrObject] = value
      }
    }
    const findOne = function (selector) { return target.querySelector(selector) }
    const find = function (selector) { return [...target.querySelectorAll(selector)] }
    const touch = function () {}
    const on = function (types, path) {
      for (const type of types.split(',')) {
        target.addEventListener(type.trim(), function (event) {
          const handler = valueAtPath(scoped(scope, dataPath, path))
          if (typeof handler === 'function') handler(event, target)
        })
      }
    }
    // in a component script, `register(data)` (single object arg) establishes the
    // component's PRIVATE scope (seeds instance data — see hello.component.html);
    // `register(name, object)` registers globally.
    const register = function (nameOrData, object) {
      if (object === undefined && nameOrData !== null && typeof nameOrData === 'object') {
        set(nameOrData)
        return
      }
      tosi({ [nameOrData]: object })
    }
    // real b8r distinguishes the two scopes: the script's bare `get`/`set` are
    // component-scoped, but `b8r.get`/`b8r.set` take ABSOLUTE registry paths
    // (`b8r.set('example4.clicks', …)`). Mirror that: path-walk the xin registry.
    const b8rGet = function (path) { return valueAtPath(scoped(scope, dataPath, path)) }
    const b8rSet = function (path, value) {
      const absolute = scoped(scope, dataPath, path)
      const parts = absolute.split('.')
      let node = xin
      for (let i = 0; i < parts.length - 1; i = i + 1) {
        if (node === null || node === undefined) return
        node = node[parts[i]]
      }
      if (node !== null && node !== undefined) node[parts[parts.length - 1]] = value
    }
    // b8r.trigger(type, element): synthesize a native event at the element. b8r
    // dispatched a plain Event then ran its delegated handling; with our wiring,
    // a bubbling dispatch reaches both direct and delegated listeners.
    const trigger = function (type, element) {
      // use the element's own realm's Event — a foreign Event (e.g. bun's global
      // in headless runs) dispatches but invokes no linkedom listeners
      const view = element.ownerDocument === null ? null : element.ownerDocument.defaultView
      const EventClass = view !== null && view.Event !== undefined ? view.Event : Event
      element.dispatchEvent(new EventClass(type, { bubbles: true }))
    }
    const b8r = { get: b8rGet, set: b8rSet, find, findOne, on, touch, register, trigger, getListInstance }

    hydrateB8r(target, { resolve: function (path) { return scoped(scope, dataPath, path) } })

    if (script !== '') {
      const run = new AsyncFunction(
        'component', 'b8r', 'get', 'set', 'find', 'findOne', 'on', 'touch', 'data', 'register', '_import',
        script
      )
      await run(target, b8r, get, set, find, findOne, on, touch, xin._b8r[id], register, _import)
    }
    // components compose: mount declared components in the hydrated subtree
    // (including any that arrived inside transcluded children)
    await hydrateB8rComponents(target)
    return id
  }
}

// Register a legacy component under `name` in the SHARED component registry
// (b8r-blueprint's), so declarative `<b8r-component>` markup, the pending
// mechanism, and legacy/modern composition all work across both forms.
export function defineLegacyComponent (name, source, options = {}) {
  const mount = loadB8rComponent(source, options)
  return defineExternalComponent(name, mount)
}

// Importing this module enables the legacy html form for declarative paths:
// `<b8r-component path="components/hello">` means `components/hello.component.html`,
// fetched and defined on demand. (Registered as a hook so the blueprint loader
// stays legacy-free when this module isn't imported.)
setLegacyComponentLoader(async function (name, url) {
  const response = await fetch(url)
  if (!response.ok) throw new Error('b8r-tjs: could not fetch legacy component ' + url + ' (' + response.status + ')')
  const source = await response.text()
  return defineLegacyComponent(name, source, { base: url })
})
