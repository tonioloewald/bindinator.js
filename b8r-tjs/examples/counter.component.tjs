/*#
# Counter

The target authoring model — and it actually runs (see `test/component.test.ts`
and `test/ssg-hydrate.test.ts`). A **redefinable definition**, not a custom
element; a view from the **element creator** (no HTML slab); styles as **data
keyed off CSS variables** (no CSS slab); behaviour as **named methods** and a
typed tjs function whose example values are its types.

Wiring is declarative and serializable: `bindText: 'count'` and `onClick: 'inc'`
become `data-bind` / `data-event` attributes. That is what lets the same view be
pre-rendered to static HTML (`renderToString`) and **hydrated in place**
(`hydrate`) — adopted node-for-node, never rebuilt. Bindings are wiring: when
`count` changes, only that one node updates; the view builds the DOM once.
*/

import { defineComponent, elements, css, vars } from '../src/index.tjs'

const { div, span, button } = elements

// behaviour is a plain, typed function — `count: 0` / `by: 1` are its types
export function step (count: 0, by: 1) {
  return count + by
}

export const counter = defineComponent({
  name: 'counter',
  state: { count: 0 },
  methods: {
    dec (ctx) { ctx.set('count', step(ctx.get('count'), -1)) },
    inc (ctx) { ctx.set('count', step(ctx.get('count'), 1)) }
  },
  style: css({
    '.counter': {
      display: 'inline-flex',
      alignItems: 'center',
      gap: vars.spacingSmall
    },
    button: { font: 'inherit', cursor: 'pointer' }
  }),
  view: () => div(
    { class: 'counter' },
    button('−', { onClick: 'dec' }),
    span({ bindText: 'count' }),
    button('+', { onClick: 'inc' })
  )
})

// client:  mount('counter', document.querySelector('#app'))
// static:  const html = renderToString('counter')        // SEO + TTFI
// hydrate: hydrate('counter', serverRenderedEl, { count: 0 })  // adopt the DOM
// reload:  call defineComponent({ name: 'counter', ... }) again — live instances
//          re-render from the new definition, state preserved.
