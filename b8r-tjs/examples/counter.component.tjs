/*#
# Counter

The target authoring model — and now it actually runs (see
`test/component.test.ts`). A **redefinable definition**, not a custom element; a
view built from the **element creator** (no HTML slab); styles as **data keyed
off CSS variables** (no CSS slab); behaviour as a typed tjs function whose
example values are its types.

Bindings are **wiring**: `bindText: 'count'` updates just that one node when
`count` changes. The view builds the DOM once — it is not a function of state and
is not re-run on every change.
*/

import { defineComponent, mount, elements, css, vars } from '../src/index.tjs'

const { div, span, button } = elements

// behaviour is a plain, typed function — `count: 0` / `by: 1` are its types
export function step (count: 0, by: 1) {
  return count + by
}

export const counter = defineComponent({
  name: 'counter',
  state: { count: 0 },
  style: css({
    '.counter': {
      display: 'inline-flex',
      alignItems: 'center',
      gap: vars.spacingSmall
    },
    button: { font: 'inherit', cursor: 'pointer' }
  }),
  view: (ctx) => div(
    { class: 'counter' },
    button('−', { onClick: () => ctx.set('count', step(ctx.get('count'), -1)) }),
    span({ bindText: 'count' }),
    button('+', { onClick: () => ctx.set('count', step(ctx.get('count'), 1)) })
  )
})

// mount it: mount('counter', document.querySelector('#app'))
// hot reload: call defineComponent({ name: 'counter', ... }) again — every
// mounted instance re-renders from the new definition, state preserved.
