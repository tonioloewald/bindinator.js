/*#
# Counter

A **b8r component**, authored in tjs. This is the target: b8r's component model
(the one existing components are already written in) running on tosijs, with
tjs supplying typed behaviour and inline tests.

Wiring is declarative and serializable — `bindText:` and `onClick:` become
`data-bind` / `data-event` attributes — so the same view can be built at mount
time or **hydrated in place** from markup that was already in the page
(`hydrateB8r`), adopted node-for-node rather than rebuilt. Bindings are wiring:
when `count` changes, only that one node updates.

Behaviour lives in the definition; data lives in state. A redefinition
hot-reloads live instances, preserving their data and taking the *new*
behaviour — so editing `step` below and re-defining actually changes what the
buttons do.
*/

import { defineB8rComponent } from '../src/b8r-blueprint.js'

// behaviour is a plain, typed function — `count: 0` / `by: 1` are its types,
// and the return example doubles as a free signature test
export function step (count: 0, by: 1): 1 {
  return count + by
}

test 'step adds, and subtracts with a negative delta' {
  expect(step(5, 2)).toBe(7)
  expect(step(5, -1)).toBe(4)
}

export const counter = defineB8rComponent('counter', {
  css: ({ css, vars }) => css({
    '._component_ .counter': {
      display: 'inline-flex',
      alignItems: 'center',
      gap: vars.spacingSmall_8px
    },
    '._component_ button': { font: 'inherit', cursor: 'pointer' }
  }),
  view: ({ div, span, button }) => div(
    { class: 'counter' },
    button('−', { onClick: '_component_.dec' }),
    span({ bindText: '_component_.count' }),
    button('+', { onClick: '_component_.inc' })
  ),
  initialValue: ({ component }) => ({
    count: 0,
    inc () { component.data.count = step(component.data.count, 1) },
    dec () { component.data.count = step(component.data.count, -1) }
  })
})

// mount:    mountB8rComponent(document.querySelector('#app'), 'counter')
// markup:   <b8r-component name="counter"></b8r-component> + hydrateB8rComponents(root)
// hydrate:  hydrateB8r(el) adopts authored data-bind/data-event markup in place
// reload:   call defineB8rComponent('counter', …) again — live instances re-stamp
//           with their data preserved and the NEW behaviour.
