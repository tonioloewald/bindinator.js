/*#
# Counter

A sketch of the target authoring model for b8r-tjs components. There are **no
slabs of HTML or CSS** here: the view is built with the element creator and the
styles are a plain object keyed off CSS variables. The behaviour is a tjs
function whose example values (`count: 0`, `by: 1`) are simultaneously its
types, its docs, and — via inline `test` blocks — its tests.

> This file is illustrative and is not part of the built `src/`. It shows where
> the framework is going (component model, step 2 on the roadmap), built on the
> tosijs `Component` / `elements` / `css` primitives.
*/

import { Component, elements, css, vars } from 'tosijs'

const { div, button, span } = elements

// behaviour lives in plain, typed functions — examples are the types
export function step (count: 0, by: 1) {
  return count + by
}

export class CounterComponent extends Component {
  // styles as data, keyed off CSS variables — no CSS slab
  static shadowStyleSpec = css({
    ':host': {
      display: 'inline-flex',
      alignItems: 'center',
      gap: vars.spacingSmall_100
    },
    button: {
      font: 'inherit',
      cursor: 'pointer'
    }
  })

  count = 0

  // the view is real DOM nodes, composed in JavaScript — no HTML slab
  content = () => div(
    button('−', { onClick: () => { this.count = step(this.count, -1) } }),
    span({ dataBind: 'text=count' }),
    button('+', { onClick: () => { this.count = step(this.count, 1) } })
  )
}

export const component = CounterComponent.elementCreator({ tag: 'b8r-counter' })
