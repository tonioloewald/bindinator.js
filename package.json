{
  "name": "b8rjs",
  "version": "0.6.11",
  "description": "the even lazier javascript framework",
  "main": "dist/b8r.js",
  "scripts": {
    "start": "echo \"http://localhost:8017/index.html\\n\" && node utils/server.js web_root:.",
    "lint": "npx eslint . --fix",
    "format": "npm run lint && npx prettier --write .",
    "stylelint": "npx stylelint css/*.css --fix",
    "linthtml": "npx linthtml index.html components/**/*.html",
    "build": "npm run format && npm run linthtml && npm run stylelint && ./utils/build.command"
  },
  "keywords": [
    "javascript",
    "front end",
    "html",
    "mvc",
    "framework",
    "state management",
    "components",
    "web-components",
    "custom-elements",
    "reactive",
    "async"
  ],
  "files": [
    "index.js",
    "components/*",
    "css/*",
    "dist/*",
    "lib/*",
    "source/*",
    "web-components/*",
    "third-party/*",
    "utils/*"
  ],
  "stylelint": {
    "extends": "stylelint-config-recommended",
    "rules": {
      "block-no-empty": null,
      "no-descending-specificity": null
    }
  },
  "author": "Tonio Loewald (https://bindinator.com)",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@linthtml/linthtml": "^0.10.2",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "rollup": "^4.62.4",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "uglify-es": "^3.3.9"
  }
}
